# ─── Copiar para .env antes do primeiro `docker compose up` ──────────────────
# Valores abaixo são apenas para DESENVOLVIMENTO LOCAL. Não usar em produção.

# ─── Base de dados da aplicação ──────────────────────────────────────────────
POSTGRES_DB=smarthome
POSTGRES_USER=postgres
POSTGRES_PASSWORD=smarthome-dev

# ─── Base de dados do Authentik ──────────────────────────────────────────────
PG_USER=authentik
PG_PASS=authentik-dev
PG_DB=authentik

# ─── Authentik ───────────────────────────────────────────────────────────────
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.2.3
AUTHENTIK_SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
COMPOSE_PORT_HTTP=9090
COMPOSE_PORT_HTTPS=9444

# ─── RabbitMQ / MQTT ─────────────────────────────────────────────────────────
RABBITMQ_USER=smarthome
RABBITMQ_PASS=smarthome-dev

# ─── InfluxDB ────────────────────────────────────────────────────────────────
INFLUXDB_USER=admin
INFLUXDB_PASS=smarthome-dev
INFLUXDB_TOKEN=dev-only-influx-token-change-me
INFLUXDB_ORG=smarthome
INFLUXDB_BUCKET=smarthome_metrics

# ─── Contas de demonstração (Authentik) ──────────────────────────────────────
# Criadas no primeiro arranque pelo blueprint blueprints/smarthome.yaml.
# Login no frontend (http://localhost:300) via Authentik (http://localhost:9090)
DEMO_ADMIN_USER=akadmin
DEMO_ADMIN_PASSWORD=demo-admin-change-me

DEMO_MARIA_EMAIL=mariasilveira@email.com
DEMO_MARIA_PASSWORD=demo-maria-change-me

DEMO_JONAS_EMAIL=jonaspistolas@email.com
DEMO_JONAS_PASSWORD=demo-jonas-change-me